# Listen address
HOST=0.0.0.0
PORT=8080

# SQLite database file (directory is created if missing)
DB_PATH=./data/scsync.db

# Built web client; relative to the working directory or absolute
STATIC_DIR=../web/dist

# SoundCloud API app credentials. Leave both empty to run in oEmbed mode
# (no durations/album detection; the client expands playlists via the widget).
SC_CLIENT_ID=
SC_CLIENT_SECRET=

# Playback timing, milliseconds
READY_TIMEOUT_MS=20000
END_TIMEOUT_MS=30000
HEARTBEAT_TIMEOUT_MS=15000
START_LEAD_MS=1500

# Maximum tracks accepted from one collection import
MAX_IMPORT_TRACKS=500

# Behind a reverse proxy: take the client IP from X-Forwarded-For for rate limiting
TRUST_PROXY=false

RUST_LOG=info,tower_http=info
